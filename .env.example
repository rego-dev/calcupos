# Copy to .env and fill in real values. Do NOT commit .env.

# PostgreSQL connection (pooled) used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Secret used to encrypt/sign the session cookie (iron-session). MUST be >= 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-32+-character-string"
